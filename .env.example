# OpenTermius Environment Variables

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=development # development | production
APP_SECRET=change-this-to-a-secure-random-32-byte-hex-key

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opentermius?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# JWT & Authentication
JWT_SECRET=change-this-to-a-very-long-and-secure-secret-token
JWT_EXPIRATION_HOURS=72

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# WebSocket & Terminal Bridge
TERMINAL_PING_INTERVAL_SECONDS=30
TERMINAL_MAX_BUFFER_BYTES=1048576 # 1 MiB

# Cloud Integrations (Optional)
AWS_ENABLED=false
AZURE_ENABLED=false
DIGITALOCEAN_ENABLED=false
